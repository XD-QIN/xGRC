    "MENU › Network › Bluetooth › Pairing (2020–21 bodies: Network › Transfer/Remote › Bluetooth Function, then Pairing). Turn Bluetooth Rmt Ctrl On to use the remote.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (Modelle von 2020–21: Network › Transfer/Remote › Bluetooth Function, dann Pairing). Stelle Bluetooth Rmt Ctrl auf On, um den Fernauslöser zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (modelos de 2020–21: Network › Transfer/Remote › Bluetooth Function, y luego Pairing). Pon Bluetooth Rmt Ctrl en On para usar el control remoto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (modelos de 2020–21: Network › Transfer/Remote › Bluetooth Function, y luego Pairing). Pon Bluetooth Rmt Ctrl en On para usar el control remoto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (boîtiers 2020–21 : Network › Transfer/Remote › Bluetooth Function, puis Pairing). Réglez Bluetooth Rmt Ctrl sur On pour utiliser la télécommande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (2020–21 के बॉडी: Network › Transfer/Remote › Bluetooth Function, फिर Pairing)। रिमोट इस्तेमाल करने के लिए Bluetooth Rmt Ctrl को On करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (bodi 2020–21: Network › Transfer/Remote › Bluetooth Function, lalu Pairing). Setel Bluetooth Rmt Ctrl ke On untuk memakai remote."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (modelli 2020–21: Network › Transfer/Remote › Bluetooth Function, poi Pairing). Imposta Bluetooth Rmt Ctrl su On per usare il telecomando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing（2020–21年のボディ：Network › Transfer/Remote › Bluetooth Function、次にPairing）。リモートを使うには「Bluetooth Rmt Ctrl」をOnにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing(2020–21년 바디: Network › Transfer/Remote › Bluetooth Function, 이어서 Pairing). 리모컨을 사용하려면 Bluetooth Rmt Ctrl을 On으로 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing (modelos 2020–21: Network › Transfer/Remote › Bluetooth Function, depois Pairing). Ajuste Bluetooth Rmt Ctrl para On para usar o controle remoto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing（2020–21 年的机身：Network › Transfer/Remote › Bluetooth Function，然后 Pairing）。要使用遥控，请将 Bluetooth Rmt Ctrl 设为 On。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MENU › Network › Bluetooth › Pairing（2020–21 年的機身：Network › Transfer/Remote › Bluetooth Function，然後 Pairing）。要使用遙控，請將 Bluetooth Rmt Ctrl 設為 On。"
          }
        }
      }
    },
