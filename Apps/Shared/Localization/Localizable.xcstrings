    "Another phone, watch or app is sending this camera its location. Stop it there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Telefon, eine andere Uhr oder App sendet dieser Kamera ihren Standort. Beende es dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro móvil, reloj o app está enviando su ubicación a esta cámara. Detenlo allí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro celular, reloj o app está enviando su ubicación a esta cámara. Detenlo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre téléphone, une autre montre ou une autre app envoie sa position à cet appareil. Arrêtez-le là-bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा फ़ोन, वॉच या ऐप इस कैमरे को अपना स्थान भेज रहा है। उसे वहीं रोकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel, jam tangan, atau aplikasi lain sedang mengirim lokasinya ke kamera ini. Hentikan di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro telefono, orologio o app sta inviando la posizione a questa fotocamera. Interrompilo lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのスマートフォン、ウォッチ、またはアプリがこのカメラに位置情報を送信しています。そちらで停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 휴대폰, 워치 또는 앱이 이 카메라에 위치를 보내고 있습니다. 그쪽에서 중지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro celular, relógio ou app está enviando a localização para esta câmera. Pare o envio por lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一部手机、手表或 App 正在向这台相机发送位置。请在那里停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一支手機、手錶或 App 正在向這台相機傳送位置。請在那裡停止。"
          }
        }
      }
    },
