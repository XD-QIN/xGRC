    "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Confirm the code on the camera within 30 s. For geotags, turn on Location sync there too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Bestätige den Code an der Kamera innerhalb von 30 s. Für Geotags schalte dort auch Location sync ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Confirma el código en la cámara antes de 30 s. Para las geoetiquetas, activa también Location sync ahí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Confirma el código en la cámara antes de 30 s. Para las geoetiquetas, activa también Location sync ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Confirmez le code sur l’appareil sous 30 s. Pour le géomarquage, activez aussi Location sync au même endroit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration। 30 सेकंड के भीतर कैमरे पर कोड की पुष्टि करें। जियोटैग के लिए वहीं Location sync भी चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Konfirmasi kode di kamera dalam 30 dtk. Untuk geotag, nyalakan juga Location sync di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Conferma il codice sulla fotocamera entro 30 s. Per il geotag, attiva lì anche Location sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration。30秒以内にカメラでコードを確認してください。ジオタグを使うには、同じ場所で「Location sync」もオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. 30초 안에 카메라에서 코드를 확인하세요. 지오태그를 쓰려면 같은 곳에서 Location sync도 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration. Confirme o código na câmera em até 30 s. Para geomarcação, ative também Location sync no mesmo lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration。请在 30 秒内于相机上确认配对码。如需地理标记，也请在那里开启 Location sync。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Network/USB Setting › Bluetooth/Smartphone Setting › Pairing Registration。請在 30 秒內於相機上確認配對碼。如需地理標記，也請在那裡開啟 Location sync。"
          }
        }
      }
    },
