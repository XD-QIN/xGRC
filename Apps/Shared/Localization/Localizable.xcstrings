    "Waiting for the camera to ask. It asks every 10 s while Location sync is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf die Anfrage der Kamera. Sie fragt alle 10 s, solange Location sync an ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que la cámara pida la ubicación. La pide cada 10 s mientras Location sync está activado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que la cámara pida la ubicación. La pide cada 10 s mientras Location sync está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’une demande de l’appareil. Il demande toutes les 10 s tant que Location sync est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे के माँगने की प्रतीक्षा। Location sync चालू रहने पर वह हर 10 सेकंड में माँगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu kamera meminta. Kamera meminta setiap 10 dtk selama Location sync menyala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa della richiesta della fotocamera. La invia ogni 10 s mentre Location sync è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラからの要求を待っています。「Location sync」がオンのあいだ、カメラは10秒ごとに要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라의 요청을 기다리는 중입니다. Location sync가 켜져 있으면 카메라가 10초마다 요청합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando a câmera pedir. Ela pede a cada 10 s enquanto Location sync está ativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待相机请求。Location sync 开启时，相机每 10 秒请求一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待相機要求。Location sync 開啟時，相機每 10 秒要求一次。"
          }
        }
      }
    },
