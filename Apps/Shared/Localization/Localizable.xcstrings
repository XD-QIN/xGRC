          }
        }
      }
    },
    "Set the camera to BULB. One tap opens the shutter, counts down and closes it. A tap during the bulb closes it early. 0 min 0 s turns it off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die Kamera auf BULB. Einmal tippen öffnet den Verschluss, zählt herunter und schließt ihn. Tippen während der Bulb-Belichtung schließt ihn früher. 0 min 0 s schaltet es aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la cámara en BULB. Un toque abre el obturador, hace la cuenta atrás y lo cierra. Un toque durante el bulb lo cierra antes. 0 min 0 s lo desactiva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la cámara en BULB. Un toque abre el obturador, hace la cuenta regresiva y lo cierra. Un toque durante el bulb lo cierra antes. 0 min 0 s lo desactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez l’appareil sur BULB. Un toucher ouvre l’obturateur, décompte et le ferme. Un toucher pendant la pose le ferme plus tôt. 0 min 0 s la désactive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे को BULB पर सेट करें। एक टैप शटर खोलता है, काउंटडाउन चलाता है और उसे बंद करता है। बल्ब के दौरान टैप करने से वह जल्दी बंद हो जाता है। 0 मि 0 से पर यह बंद रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur kamera ke BULB. Satu ketukan membuka rana, menghitung mundur, lalu menutupnya. Ketukan selama bulb menutupnya lebih awal. 0 mnt 0 dtk mematikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la fotocamera su BULB. Un tocco apre l'otturatore, fa il conto alla rovescia e lo chiude. Un tocco durante la posa B lo chiude prima. 0 min 0 s la disattiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラをBULBに設定してください。1回タップするとシャッターを開き、カウントダウンして閉じます。バルブ中にタップすると早めに閉じます。0分0秒でオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 BULB로 설정하세요. 한 번 탭하면 셔터를 열고 카운트다운한 뒤 닫습니다. 벌브 중에 탭하면 일찍 닫습니다. 0분 0초로 하면 꺼집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a câmera para BULB. Um toque abre o obturador, faz a contagem regressiva e o fecha. Um toque durante o bulb o fecha antes. 0 min 0 s desativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将相机设为 BULB。轻点一下即打开快门、倒计时并关闭快门。B 门期间轻点会提前关闭。0 分 0 秒为关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將相機設為 BULB。輕點一下即開啟快門、倒數並關閉快門。B 快門期間輕點會提前關閉。0 分 0 秒為關閉。"
          }
        }
      }
    },
