    "Bring %@ closer to the camera. If it keeps failing, turn Bluetooth off and on in Control Center.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring %@ näher an die Kamera. Wenn es weiter fehlschlägt, schalte Bluetooth im Kontrollzentrum aus und wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca %@ a la cámara. Si sigue fallando, desactiva y activa Bluetooth en el Centro de control."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca %@ a la cámara. Si sigue fallando, desactiva y activa Bluetooth en el Centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez %@ de l’appareil. Si l’échec persiste, désactivez puis réactivez le Bluetooth dans le Centre de contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को कैमरे के पास लाएँ। अगर बार-बार विफल हो, तो कंट्रोल सेंटर में Bluetooth बंद करके फिर चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekatkan %@ ke kamera. Jika terus gagal, matikan lalu nyalakan Bluetooth di Pusat Kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina %@ alla fotocamera. Se continua a non riuscire, spegni e riaccendi il Bluetooth in Centro di Controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をカメラに近づけてください。それでも失敗する場合は、コントロールセンターでBluetoothをオフにしてからオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라와 %@ 사이의 거리를 좁히세요. 계속 실패하면 제어 센터에서 Bluetooth를 껐다가 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime %@ da câmera. Se continuar falhando, desative e ative o Bluetooth na Central de Controle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将%@靠近相机。如果仍然失败，请在控制中心关闭再打开蓝牙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將%@靠近相機。如果仍然失敗，請在控制中心關閉再開啟藍牙。"
          }
        }
      }
    },
