    "Linked to another phone, watch or app. Disconnect it there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit anderem Telefon, anderer Uhr oder App verbunden. Trenne sie dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculada a otro móvil, reloj o app. Desconéctala allí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculada a otro celular, reloj o app. Desconéctala allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lié à un autre téléphone, une autre montre ou une autre app. Déconnectez-le là-bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे फ़ोन, वॉच या ऐप से लिंक है। उसे वहीं डिस्कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tertaut ke ponsel, jam tangan, atau aplikasi lain. Putuskan di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegata a un altro telefono, orologio o app. Disconnettila da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのスマートフォン、ウォッチ、またはアプリに接続中です。そちらで接続を解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 휴대폰, 워치 또는 앱에 연결되어 있습니다. 그쪽에서 연결을 해제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinculado a outro celular, relógio ou app. Desconecte por lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接到其他手机、手表或 App。请在那里断开连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線到其他手機、手錶或 App。請在那裡中斷連線。"
          }
        }
      }
    },
