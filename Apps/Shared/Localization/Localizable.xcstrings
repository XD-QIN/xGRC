    "Taken. The camera confirmed it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgenommen. Die Kamera hat es bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecha. La cámara la ha confirmado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomada. La cámara la confirmó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo prise. L’appareil l’a confirmée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो ली गई। कैमरे ने पुष्टि की।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diambil. Kamera mengonfirmasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scattata. La fotocamera l'ha confermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影しました。カメラが確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영했습니다. 카메라가 확인했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tirada. A câmera confirmou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拍摄。相机已确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拍攝。相機已確認。"
          }
        }
      }
    },
    "Takes a photo on the connected camera and says whether the camera confirmed it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt ein Foto mit der verbundenen Kamera auf und sagt, ob die Kamera es bestätigt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace una foto con la cámara conectada e indica si la cámara la confirmó."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una foto con la cámara conectada e indica si la cámara la confirmó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend une photo avec l’appareil connecté et indique si l’appareil l’a confirmée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट किए गए कैमरे पर फ़ोटो लेता है और बताता है कि कैमरे ने पुष्टि की या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil foto dengan kamera yang terhubung dan memberi tahu apakah kamera mengonfirmasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta una foto con la fotocamera connessa e dice se la fotocamera l'ha confermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中のカメラで写真を撮影し、カメラが確認したかどうかを伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 카메라로 사진을 촬영하고, 카메라가 확인했는지 알려 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira uma foto na câmera conectada e diz se a câmera a confirmou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用已连接的相机拍照，并告诉你相机是否已确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用已連線的相機拍照，並告訴你相機是否已確認。"
          }
        }
      }
    },
