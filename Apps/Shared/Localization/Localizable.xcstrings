    "Set Bluetooth to On in the camera's communication settings, then confirm the passkey shown on the camera. For geotags, turn on Store Location Info.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle Bluetooth in den Kommunikationseinstellungen der Kamera auf On und bestätige dann den an der Kamera angezeigten Code. Für Geotags schalte Store Location Info. ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Bluetooth en los ajustes de comunicación de la cámara y luego confirma la clave que muestra la cámara. Para las geoetiquetas, activa Store Location Info."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Bluetooth en la configuración de comunicación de la cámara y luego confirma la clave que muestra la cámara. Para las geoetiquetas, activa Store Location Info."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez Bluetooth sur On dans les réglages de communication de l’appareil, puis confirmez le code affiché sur l’appareil. Pour le géomarquage, activez Store Location Info."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की कम्युनिकेशन सेटिंग्स में Bluetooth को On करें, फिर कैमरे पर दिखाई गई पासकी की पुष्टि करें। जियोटैग के लिए Store Location Info. चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setel Bluetooth ke On di pengaturan komunikasi kamera, lalu konfirmasi kode sandi yang tampil di kamera. Untuk geotag, nyalakan Store Location Info."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta Bluetooth su On nelle impostazioni di comunicazione della fotocamera, poi conferma il codice mostrato sulla fotocamera. Per il geotag, attiva Store Location Info."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの通信設定でBluetoothをOnにしてから、カメラに表示されたパスキーを確認してください。ジオタグを使うには「Store Location Info.」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라의 통신 설정에서 Bluetooth를 On으로 설정한 다음, 카메라에 표시된 패스키를 확인하세요. 지오태그를 쓰려면 Store Location Info.를 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste Bluetooth para On nos ajustes de comunicação da câmera e depois confirme o código mostrado na câmera. Para geomarcação, ative Store Location Info."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相机的通信设置中将 Bluetooth 设为 On，然后确认相机上显示的配对码。如需地理标记，请开启 Store Location Info.。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在相機的通訊設定中將 Bluetooth 設為 On，然後確認相機上顯示的配對碼。如需地理標記，請開啟 Store Location Info.。"
          }
        }
      }
    },
    "Set shutter-open time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belichtungszeit festlegen"
          }
        },
        "es": {
