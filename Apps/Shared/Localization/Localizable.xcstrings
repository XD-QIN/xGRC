    "No focus confirmation. Set the shutter button to start AF, or use AF hold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fokusbestätigung. Stelle den Auslöser so ein, dass er den AF startet, oder nutze „AF halten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin confirmación de enfoque. Configura el disparador para iniciar el AF, o usa Mantener AF."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin confirmación de enfoque. Configura el disparador para iniciar el AF, o usa Mantener AF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de confirmation de mise au point. Réglez le déclencheur pour lancer l’AF, ou utilisez Maintien AF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस की पुष्टि नहीं। शटर बटन को AF शुरू करने के लिए सेट करें, या AF होल्ड इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada konfirmasi fokus. Atur tombol rana untuk memulai AF, atau gunakan Tahan AF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna conferma di messa a fuoco. Imposta il pulsante di scatto per avviare l'AF, o usa Mantieni AF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスの確認がありません。シャッターボタンでAFが始まるように設定するか、AFホールドを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초점 확인이 없습니다. 셔터 버튼으로 AF가 시작되도록 설정하거나 AF 유지를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem confirmação de foco. Ajuste o botão do obturador para iniciar o AF, ou use Manter AF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有对焦确认。请将快门按钮设为启动 AF，或使用 AF 保持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有對焦確認。請將快門按鈕設為啟動 AF，或使用 AF 保持。"
          }
        }
      }
    },
