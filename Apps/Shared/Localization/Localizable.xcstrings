    "Sends your location to the connected camera so photos are geotagged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet deinen Standort an die verbundene Kamera, damit Fotos einen Geotag erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu ubicación a la cámara conectada para geoetiquetar las fotos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu ubicación a la cámara conectada para geoetiquetar las fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie votre position à l’appareil connecté pour géomarquer les photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्थान कनेक्ट किए गए कैमरे को भेजता है ताकि फ़ोटो जियोटैग हों।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim lokasi Anda ke kamera yang terhubung agar foto diberi geotag."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia la tua posizione alla fotocamera connessa, così le foto ricevono il geotag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中のカメラに位置情報を送信し、写真にジオタグを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 카메라에 위치를 보내 사진에 지오태그가 기록되게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia a sua localização à câmera conectada para que as fotos sejam geomarcadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的位置发送到已连接的相机，为照片添加地理标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你的位置傳送到已連線的相機，為照片加上地理標記。"
          }
        }
      }
    },
