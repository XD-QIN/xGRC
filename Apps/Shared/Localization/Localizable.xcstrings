          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机仅在 Self-timer: 10 s/remote 或 2 s/remote 驱动模式下响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機僅在 Self-timer: 10 s/remote 或 2 s/remote 驅動模式下回應。"
          }
        }
      }
    },
    "The camera refused the command. Check that it is not in playback or a menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera hat den Befehl abgelehnt. Prüfe, ob sie in der Wiedergabe oder in einem Menü ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara ha rechazado la orden. Comprueba que no esté en reproducción ni en un menú."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara rechazó el comando. Verifica que no esté en reproducción ni en un menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil a refusé la commande. Vérifiez qu’il n’est pas en lecture ou dans un menu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे ने कमांड अस्वीकार किया। जाँचें कि वह प्लेबैक या किसी मेनू में न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera menolak perintah. Pastikan kamera tidak dalam mode putar ulang atau menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera ha rifiutato il comando. Controlla che non sia in riproduzione o in un menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラがコマンドを拒否しました。再生中やメニュー表示中でないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 명령을 거부했습니다. 재생 화면이나 메뉴에 있지 않은지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera recusou o comando. Verifique se ela não está na reprodução ou num menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机拒绝了指令。请确认它没有处于回放或菜单中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機拒絕了指令。請確認它沒有處於播放或選單中。"
          }
        }
      }
    },
    "The camera was not found. Check that it is in pairing mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wurde nicht gefunden. Prüfe, ob sie im Kopplungsmodus ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado la cámara. Comprueba que esté en modo de emparejamiento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la cámara. Verifica que esté en modo de emparejamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil est introuvable. Vérifiez qu’il est en mode jumelage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा नहीं मिला। जाँचें कि वह पेयरिंग मोड में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak ditemukan. Pastikan kamera dalam mode pemasangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è stata trovata. Controlla che sia in modalità di abbinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが見つかりませんでした。ペアリングモードになっているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 찾지 못했습니다. 페어링 모드인지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não foi encontrada. Verifique se ela está no modo de emparelhamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到相机。请确认它处于配对模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到相機。請確認它處於配對模式。"
          }
        }
      }
    },
    "The camera's firmware changed. Forget and pair again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Firmware der Kamera hat sich geändert. Vergessen und erneut koppeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware de la cámara ha cambiado. Olvídala y vuelve a emparejarla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware de la cámara cambió. Olvídala y vuelve a emparejarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le firmware de l’appareil a changé. Oubliez-le et jumelez à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे का फ़र्मवेयर बदल गया है। भूलें और फिर से पेयर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware kamera berubah. Lupakan dan pasangkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il firmware della fotocamera è cambiato. Dimenticala e abbinala di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのファームウェアが変更されました。登録を解除して、もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 펌웨어가 변경되었습니다. 지운 다음 다시 페어링하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O firmware da câmera mudou. Esqueça e emparelhe de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机固件已更改。请忽略后重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機韌體已變更。請忘記後重新配對。"
          }
        }
      }
    },
    "The link dropped during a bulb. Check the camera: the shutter may still be open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung ist während einer Bulb-Belichtung abgebrochen. Prüfe die Kamera: Der Verschluss ist eventuell noch offen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cortado la conexión durante un bulb. Revisa la cámara: puede que el obturador siga abierto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cortó la conexión durante un bulb. Revisa la cámara: puede que el obturador siga abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liaison a été perdue pendant une pose B. Vérifiez l’appareil : l’obturateur est peut-être encore ouvert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बल्ब के दौरान लिंक टूट गया। कैमरा जाँचें: शटर शायद अब भी खुला है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan terputus saat bulb. Periksa kamera: rana mungkin masih terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è caduta durante una posa B. Controlla la fotocamera: l'otturatore potrebbe essere ancora aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バルブ中に接続が切れました。カメラを確認してください。シャッターが開いたままの可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벌브 중에 연결이 끊겼습니다. 카메라를 확인하세요. 셔터가 아직 열려 있을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão caiu durante um bulb. Verifique a câmera: o obturador pode ainda estar aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "B 门期间连接中断。请检查相机：快门可能仍处于打开状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "B 快門期間連線中斷。請檢查相機：快門可能仍處於開啟狀態。"
          }
        }
      }
    },
    "The mode is Geotag only. Change it in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modus ist „Nur Geotag“. Ändere ihn in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo es Solo geoetiqueta. Cámbialo en Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo es Solo geoetiqueta. Cámbialo en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode est Géomarquage seul. Changez-le dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोड “केवल जियोटैग” है। इसे सेटिंग्स में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode adalah Hanya geotag. Ubah di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità è Solo geotag. Cambiala in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モードが「ジオタグのみ」です。「設定」で変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드가 '지오태그만'입니다. 설정에서 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo é Só geomarcação. Mude em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模式为“仅地理标记”。请在设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前模式為「僅地理標記」。請在設定中變更。"
          }
        }
      }
    },
    "The session ended": {
      "comment": "From the xGRCCore package (DesignKit or SessionKit), looked up in this catalog at run time.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung wurde beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha finalizado"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión finalizó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session est terminée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन समाप्त हुआ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi berakhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è terminata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションが終了しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 종료되었습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão foi encerrada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已结束"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段已結束"
          }
        }
      }
    },
    "The watch will keep the camera connected only while xGRC is on screen until you use the app again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple Watch hält die Kamera nur verbunden, solange xGRC auf dem Bildschirm ist, bis du die App wieder benutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj solo mantendrá la cámara conectada mientras xGRC esté en pantalla, hasta que vuelvas a usar la app."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj solo mantendrá la cámara conectada mientras xGRC esté en pantalla, hasta que vuelvas a usar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La montre ne gardera l’appareil connecté que tant que xGRC est à l’écran, jusqu’à ce que vous utilisiez à nouveau l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप ऐप फिर से इस्तेमाल नहीं करते, वॉच कैमरे को केवल तभी कनेक्ट रखेगी जब xGRC स्क्रीन पर हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tangan hanya akan menjaga kamera tetap terhubung selama xGRC ada di layar, sampai Anda menggunakan aplikasi lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Apple Watch terrà connessa la fotocamera solo mentre xGRC è sullo schermo, finché non usi di nuovo l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをもう一度使うまで、Apple WatchはxGRCが画面に表示されているあいだだけカメラとの接続を保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 다시 사용할 때까지 Apple Watch는 xGRC가 화면에 있는 동안에만 카메라 연결을 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio só manterá a câmera conectada enquanto o xGRC estiver na tela, até você usar o app de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你再次使用此 App 之前，手表只会在 xGRC 显示在屏幕上时保持相机连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你再次使用此 App 之前，手錶只會在 xGRC 顯示於螢幕上時保持相機連線。"
          }
        }
      }
    },
    "This camera can't take locations over Bluetooth.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kamera kann keine Standorte über Bluetooth empfangen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no puede recibir ubicaciones por Bluetooth."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no puede recibir ubicaciones por Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas recevoir de position par Bluetooth."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैमरा Bluetooth पर स्थान नहीं ले सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera ini tidak dapat menerima lokasi melalui Bluetooth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fotocamera non può ricevere posizioni via Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカメラはBluetoothで位置情報を受け取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카메라는 Bluetooth로 위치를 받을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta câmera não recebe localização por Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台相机无法通过蓝牙接收位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台相機無法透過藍牙接收位置。"
          }
        }
      }
    },
    "This camera has no bulb, so the bulb time is not used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kamera hat kein Bulb, daher wird die Bulb-Zeit nicht genutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no tiene bulb, así que no se usa el tiempo de bulb."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no tiene bulb, así que no se usa el tiempo de bulb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de pose B, la durée de pose B n’est donc pas utilisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कैमरे में बल्ब नहीं है, इसलिए बल्ब समय का उपयोग नहीं होता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera ini tidak punya bulb, jadi waktu bulb tidak digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fotocamera non ha la posa B, quindi il tempo di posa B non viene usato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカメラにはバルブがないため、バルブ時間は使われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카메라에는 벌브가 없어 벌브 시간이 사용되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta câmera não tem bulb, então o tempo de bulb não é usado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台相机没有 B 门，因此不使用 B 门时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台相機沒有 B 快門，因此不使用 B 快門時間。"
          }
        }
      }
    },
    "This camera has no half-press. Double tap to shoot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kamera kennt kein halbes Drücken des Auslösers. Tippe zweimal zum Auslösen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no admite pulsar hasta la mitad. Toca dos veces para disparar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cámara no admite presionar hasta la mitad. Toca dos veces para disparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de mi-course. Touchez deux fois pour déclencher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कैमरे में आधा दबाना नहीं है। शूट करने के लिए डबल टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera ini tidak punya tekan setengah. Ketuk dua kali untuk memotret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fotocamera non ha la pressione a metà. Tocca due volte per scattare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
