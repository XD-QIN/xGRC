    "The camera is not taking locations — photos untagged. ": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera übernimmt keine Standorte — Fotos ohne Geotag. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está recibiendo ubicaciones — fotos sin geoetiqueta. "
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está recibiendo ubicaciones — fotos sin geoetiqueta. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil ne reçoit pas la position — photos non géomarquées. "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा स्थान नहीं ले रहा — फ़ोटो टैग नहीं हो रहीं। "
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak menerima lokasi — foto tanpa tag. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non riceve le posizioni — foto senza geotag. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが位置情報を受け付けていません — 写真に位置情報が記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 위치를 받지 않고 있습니다 — 사진에 위치가 기록되지 않습니다. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está recebendo a localização — fotos sem geomarcação. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机未接收位置 — 照片未标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機未接收位置 — 照片未標記。"
          }
        }
      }
    },
    "The camera is released so another phone or watch can connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird freigegeben, damit sich ein anderes Telefon oder eine andere Uhr verbinden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara queda libre para que otro móvil o reloj pueda conectarse."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara queda libre para que otro celular o reloj pueda conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil est libéré pour qu’un autre téléphone ou une autre montre puisse s’y connecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा छोड़ दिया गया है ताकि कोई दूसरा फ़ोन या वॉच कनेक्ट हो सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera dilepas agar ponsel atau jam tangan lain bisa terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera viene liberata, così un altro telefono od orologio può connettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのスマートフォンやウォッチが接続できるよう、カメラを解放しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 휴대폰이나 워치가 연결할 수 있도록 카메라를 해제했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera foi liberada para que outro celular ou relógio possa se conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已释放相机，其他手机或手表可以连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已釋放相機，其他手機或手錶可以連線。"
          }
        }
      }
    },
    "The camera may be set to back-button AF; enable AF on the shutter button for focus confirmation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist eventuell auf AF per AF-ON-Taste eingestellt; aktiviere den AF am Auslöser, um eine Fokusbestätigung zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la cámara tenga el AF en el botón trasero; activa el AF en el disparador para confirmar el enfoque."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la cámara tenga el AF en el botón trasero; activa el AF en el disparador para confirmar el enfoque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil est peut-être réglé en AF par bouton arrière ; activez l’AF sur le déclencheur pour la confirmation de mise au point."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा शायद बैक-बटन AF पर सेट है; फ़ोकस की पुष्टि के लिए शटर बटन पर AF चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera mungkin diatur ke AF tombol belakang; aktifkan AF pada tombol rana untuk konfirmasi fokus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera potrebbe essere impostata sull'AF con il pulsante posteriore; attiva l'AF sul pulsante di scatto per avere la conferma di messa a fuoco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが親指AFに設定されている可能性があります。フォーカスの確認を得るには、シャッターボタンでのAFを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 후면 버튼 AF로 설정되어 있을 수 있습니다. 초점 확인을 받으려면 셔터 버튼 AF를 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera pode estar com AF no botão traseiro; ative o AF no botão do obturador para ter confirmação de foco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机可能设为了背键对焦；请在快门按钮上启用 AF 以获得对焦确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機可能設為背鍵對焦；請在快門按鈕上啟用 AF 以取得對焦確認。"
          }
        }
      }
    },
    "The camera no longer recognises %@. Pair again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera erkennt %@ nicht mehr. Kopple erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara ya no reconoce %@. Vuelve a emparejar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara ya no reconoce %@. Vuelve a emparejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil ne reconnaît plus %@. Jumelez à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा अब %@ को नहीं पहचानता। फिर से पेयर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak lagi mengenali %@. Pasangkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non riconosce più %@. Abbina di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが%@を認識しなくなりました。もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 더 이상 %@을(를) 인식하지 않습니다. 다시 페어링하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não reconhece mais %@. Emparelhe de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机已无法识别%@。请重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機已無法辨識%@。請重新配對。"
          }
        }
      }
    },
    "The camera reacts only in Self-timer: 10 s/remote or 2 s/remote drive mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera reagiert nur in der Betriebsart Self-timer: 10 s/remote oder 2 s/remote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara solo responde en el modo de avance Self-timer: 10 s/remote o 2 s/remote."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara solo responde en el modo de avance Self-timer: 10 s/remote o 2 s/remote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil ne réagit qu’en mode d’acquisition Self-timer: 10 s/remote ou 2 s/remote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
