            "state": "translated",
            "value": "Confirmez sur %@, puis sur l’appareil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर पुष्टि करें, फिर कैमरे पर"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasi di %@, lalu di kamera"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma %@, poi sulla fotocamera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で確認してから、カメラでも確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 확인한 다음 카메라에서도 확인하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme no %@ e depois na câmera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在%@上确认，然后在相机上确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在%@上確認，然後在相機上確認"
          }
        }
      }
    },
