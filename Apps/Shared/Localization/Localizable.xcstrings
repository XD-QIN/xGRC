    "Location starts with the session. The camera's remote setting can stay off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort startet mit der Sitzung. Die Fernbedienungs-Einstellung der Kamera kann aus bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación empieza con la sesión. La opción de control remoto de la cámara puede quedar desactivada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación empieza con la sesión. La opción de control remoto de la cámara puede quedar desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi de position démarre avec la session. Le réglage de télécommande de l’appareil peut rester désactivé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान सेशन के साथ शुरू होता है। कैमरे की रिमोट सेटिंग बंद रह सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi dimulai bersama sesi. Pengaturan remote kamera boleh tetap mati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione parte con la sessione. L'impostazione del telecomando sulla fotocamera può restare spenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の送信はセッションと同時に始まります。カメラのリモート設定はオフのままでかまいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 전송은 세션과 함께 시작됩니다. 카메라의 리모컨 설정은 꺼 두어도 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização começa com a sessão. O ajuste de controle remoto da câmera pode ficar desativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置随会话开始发送。相机的遥控设置可以保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置隨工作階段開始傳送。相機的遙控設定可以保持關閉。"
          }
        }
      }
    },
