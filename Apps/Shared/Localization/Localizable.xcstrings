    "Reconnecting. The photo is taken when the camera is back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde neu. Das Foto wird aufgenommen, sobald die Kamera zurück ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectando. La foto se hará cuando vuelva la cámara."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectando. La foto se tomará cuando vuelva la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnexion. La photo sera prise au retour de l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से कनेक्ट हो रहा है। कैमरा लौटने पर फ़ोटो ली जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung ulang. Foto diambil saat kamera kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnessione in corso. La foto viene scattata quando la fotocamera torna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続しています。カメラが戻ったら撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결하는 중입니다. 카메라가 다시 연결되면 촬영합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectando. A foto será tirada quando a câmera voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新连接。相机恢复连接后即拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新連線。相機恢復連線後即拍攝。"
          }
        }
      }
    },
    "Reconnects when the link drops, and reopens the last session when xGRC starts again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet neu, wenn die Verbindung abbricht, und öffnet die letzte Sitzung wieder, wenn xGRC neu startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectar si se corta la conexión y reabre la última sesión cuando xGRC se inicia de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectar si se corta la conexión y reabre la última sesión cuando xGRC se inicia de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecte quand la liaison est perdue, et rouvre la dernière session au redémarrage de xGRC."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक टूटने पर फिर से कनेक्ट करता है, और xGRC दोबारा शुरू होने पर पिछला सेशन फिर खोलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung kembali saat tautan terputus, dan membuka kembali sesi terakhir saat xGRC dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si riconnette quando la connessione cade, e riapre l'ultima sessione quando xGRC si riavvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れると再接続し、xGRCを再び起動したときに前回のセッションを再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊기면 다시 연결하고, xGRC를 다시 시작하면 마지막 세션을 다시 엽니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecta quando a conexão cai e reabre a última sessão quando o xGRC inicia de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中断时重新连接，并在 xGRC 再次启动时重新打开上次的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中斷時重新連線，並在 xGRC 再次啟動時重新開啟上次的工作階段。"
          }
        }
      }
    },
