    "Open xGRC to allow Location.": {
      "comment": "From the xGRCCore package (DesignKit or SessionKit), looked up in this catalog at run time.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne xGRC, um den Standort zu erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre xGRC para permitir la ubicación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre xGRC para permitir la ubicación."
          }
        },
        "fr": {
