    "Already connected to this iPhone. The maker's app may hold the camera's lock while it runs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits mit diesem iPhone verbunden. Die App des Herstellers kann die Kamera belegen, solange sie läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está conectada a este iPhone. La app del fabricante puede tener bloqueada la cámara mientras se ejecuta."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está conectada a este iPhone. La app del fabricante puede tener bloqueada la cámara mientras se ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà connecté à cet iPhone. L’app du fabricant peut monopoliser l’appareil tant qu’elle est ouverte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone से पहले से कनेक्ट है। निर्माता का ऐप चलते समय कैमरे को अपने पास रोके रख सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah terhubung ke iPhone ini. Aplikasi produsen mungkin menahan kunci kamera selama berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già connessa a questo iPhone. L'app del produttore può tenere occupata la fotocamera mentre è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneにすでに接続されています。メーカーのアプリが起動しているあいだは、そのアプリがカメラを占有している場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 이미 연결되어 있습니다. 제조사 앱이 실행 중이면 그 앱이 카메라를 점유하고 있을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já conectada a este iPhone. O app do fabricante pode reter a câmera enquanto estiver aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接到这台 iPhone。厂商的 App 运行时可能会占用相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線到這支 iPhone。原廠 App 執行時可能會佔用相機。"
          }
        }
      }
    },
    "Also remove xGRC on the camera, and remove the camera in Settings › Bluetooth on this watch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne xGRC auch an der Kamera, und entferne die Kamera unter Einstellungen › Bluetooth auf dieser Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina también xGRC en la cámara, y elimina la cámara en Ajustes › Bluetooth de este reloj."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina también xGRC en la cámara, y elimina la cámara en Configuración › Bluetooth de este reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez aussi xGRC sur l’appareil, et supprimez l’appareil dans Réglages › Bluetooth sur cette montre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे पर भी xGRC हटाएँ, और इस वॉच पर सेटिंग्स › Bluetooth में कैमरे को हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus juga xGRC di kamera, dan hapus kamera di Pengaturan › Bluetooth pada jam tangan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi anche xGRC sulla fotocamera, e rimuovi la fotocamera in Impostazioni › Bluetooth su questo Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ側でもxGRCを削除し、このApple Watchの「設定」›「Bluetooth」でカメラを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에서도 xGRC를 삭제하고, 이 Apple Watch의 설정 › Bluetooth에서 카메라를 삭제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova também o xGRC na câmera e remova a câmera em Ajustes › Bluetooth neste relógio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另请在相机上移除 xGRC，并在这块手表的“设置 › 蓝牙”中移除该相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另請在相機上移除 xGRC，並在這支手錶的「設定 › 藍牙」中移除該相機。"
          }
        }
      }
    },
    "Also remove xGRC on the camera, and remove the camera in Settings › Bluetooth, which also unpairs the maker's app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne xGRC auch an der Kamera, und entferne die Kamera unter Einstellungen › Bluetooth. Dadurch wird auch die Kopplung mit der App des Herstellers aufgehoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina también xGRC en la cámara, y elimina la cámara en Ajustes › Bluetooth, lo que también desempareja la app del fabricante."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina también xGRC en la cámara, y elimina la cámara en Configuración › Bluetooth, lo que también desempareja la app del fabricante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez aussi xGRC sur l’appareil, et supprimez l’appareil dans Réglages › Bluetooth, ce qui dissocie aussi l’app du fabricant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे पर भी xGRC हटाएँ, और सेटिंग्स › Bluetooth में कैमरे को हटाएँ; इससे निर्माता के ऐप की पेयरिंग भी हट जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus juga xGRC di kamera, dan hapus kamera di Pengaturan › Bluetooth, yang juga memutus pasangan aplikasi produsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi anche xGRC sulla fotocamera, e rimuovi la fotocamera in Impostazioni › Bluetooth: così si dissocia anche l'app del produttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ側でもxGRCを削除し、「設定」›「Bluetooth」でカメラを削除してください。これでメーカーのアプリとのペアリングも解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에서도 xGRC를 삭제하고, 설정 › Bluetooth에서 카메라를 삭제하세요. 이렇게 하면 제조사 앱과의 페어링도 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova também o xGRC na câmera e remova a câmera em Ajustes › Bluetooth, o que também desemparelha o app do fabricante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另请在相机上移除 xGRC，并在“设置 › 蓝牙”中移除该相机，这也会解除厂商 App 的配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另請在相機上移除 xGRC，並在「設定 › 藍牙」中移除該相機，這也會解除原廠 App 的配對。"
          }
        }
      }
    },
    "Also sent at once when you move.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Bewegung zusätzlich sofort gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se envía de inmediato cuando te mueves."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "También se envía de inmediato cuando te mueves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aussi envoyée dès que vous bougez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चलने पर तुरंत भी भेजा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Juga langsung dikirim saat Anda bergerak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviata subito anche quando ti sposti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動したときもすぐに送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직이면 즉시 전송하기도 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também enviada na hora quando você se move."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动时也会立即发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動時也會立即傳送。"
          }
        }
      }
    },
