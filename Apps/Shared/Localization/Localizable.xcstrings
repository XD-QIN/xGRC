    "A dropped link ends the session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine abgebrochene Verbindung beendet die Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se corta la conexión, la sesión termina."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se corta la conexión, la sesión termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une liaison perdue met fin à la session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक टूटने पर सेशन समाप्त हो जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan yang terputus mengakhiri sesi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una connessione persa termina la sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れるとセッションを終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊기면 세션이 종료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conexão perdida encerra a sessão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中断即结束会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中斷即結束工作階段。"
          }
        }
      }
    },
    "A tap, Double Tap or Shoot counts down, then fires. A tap during the countdown cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, Doppeltippen oder „Auslösen“ startet den Countdown, dann wird ausgelöst. Tippen während des Countdowns bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque, un Doble toque o Disparar inicia la cuenta atrás y luego dispara. Un toque durante la cuenta atrás la cancela."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque, un Doble toque o Disparar inicia la cuenta regresiva y luego dispara. Un toque durante la cuenta regresiva la cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher, Toucher deux fois ou Déclencher lance le compte à rebours, puis déclenche. Un toucher pendant le compte à rebours annule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैप, डबल टैप या शूट से काउंटडाउन चलता है, फिर शटर फ़ायर होता है। काउंटडाउन के दौरान टैप करने से रद्द हो जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketukan, Ketuk Dua Kali, atau Potret menghitung mundur, lalu memicu rana. Ketukan selama hitung mundur membatalkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco, il Doppio tocco o Scatta avviano il conto alla rovescia, poi scattano. Un tocco durante il conto alla rovescia annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップ、手のダブルタップ、または「撮影」でカウントダウンが始まり、その後シャッターを切ります。カウントダウン中にタップするとキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭, 이중 탭 또는 '촬영'을 하면 카운트다운 후 셔터가 작동합니다. 카운트다운 중에 탭하면 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque, o Toque Duplo ou Disparar faz a contagem regressiva e depois dispara. Um toque durante a contagem cancela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点、“互点两下”手势或“拍摄”会先倒计时，然后释放快门。倒计时期间轻点即取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點、「點兩下」手勢或「拍攝」會先倒數，然後釋放快門。倒數期間輕點即取消。"
          }
        }
      }
    },
