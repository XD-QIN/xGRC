    "The camera disconnected. Auto reconnect is off in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera hat die Verbindung getrennt. Auto-Verbinden ist in den Einstellungen aus."
          }
        },
        "es": {
          "stringUnit": {
