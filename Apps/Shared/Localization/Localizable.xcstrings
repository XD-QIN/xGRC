    "Half-presses the shutter on the connected camera.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drückt den Auslöser der verbundenen Kamera halb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el disparador hasta la mitad en la cámara conectada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona el disparador hasta la mitad en la cámara conectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfonce le déclencheur à mi-course sur l’appareil connecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट किए गए कैमरे का शटर आधा दबाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menekan setengah rana pada kamera yang terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preme a metà il pulsante di scatto della fotocamera connessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中のカメラのシャッターを半押しします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 카메라의 셔터를 반셔터합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressiona o botão do obturador até a metade na câmera conectada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半按已连接相机的快门。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半按已連線相機的快門。"
          }
        }
      }
    },
    "How long a single tap keeps focus held.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange einmal Tippen den Fokus hält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo mantiene el enfoque un solo toque."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo mantiene el enfoque un solo toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle un toucher maintient la mise au point."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैप फ़ोकस को कितनी देर रोके रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama satu ketukan menahan fokus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto tempo un singolo tocco mantiene la messa a fuoco."
