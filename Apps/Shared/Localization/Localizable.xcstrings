    "The camera declined or did not answer. Start pairing on the camera again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera hat abgelehnt oder nicht geantwortet. Starte das Koppeln an der Kamera erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara lo ha rechazado o no ha respondido. Vuelve a iniciar el emparejamiento en la cámara."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara lo rechazó o no respondió. Vuelve a iniciar el emparejamiento en la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil a refusé ou n’a pas répondu. Relancez le jumelage sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे ने मना किया या जवाब नहीं दिया। कैमरे पर फिर से पेयरिंग शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera menolak atau tidak menjawab. Mulai pemasangan di kamera lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera ha rifiutato o non ha risposto. Avvia di nuovo l'abbinamento sulla fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが拒否したか、応答しませんでした。カメラでもう一度ペアリングを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 거부했거나 응답하지 않았습니다. 카메라에서 페어링을 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera recusou ou não respondeu. Inicie o emparelhamento na câmera de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机拒绝了配对或没有回应。请在相机上重新开始配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機拒絕了配對或沒有回應。請在相機上重新開始配對。"
          }
        }
      }
    },
    "The camera did not accept the pairing": {
      "localizations": {
