    "The camera did not come back in time. No photo was taken.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera war nicht rechtzeitig zurück. Es wurde kein Foto aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no ha vuelto a tiempo. No se ha hecho ninguna foto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no volvió a tiempo. No se tomó ninguna foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil n’est pas revenu à temps. Aucune photo n’a été prise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा समय पर नहीं लौटा। कोई फ़ोटो नहीं ली गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak kembali tepat waktu. Tidak ada foto yang diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è tornata in tempo. Non è stata scattata nessuna foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが時間内に再接続しませんでした。写真は撮影されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 제시간에 다시 연결되지 않았습니다. 사진은 촬영되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não voltou a tempo. Nenhuma foto foi tirada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机未及时恢复连接。未拍摄照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機未及時恢復連線。未拍攝照片。"
          }
        }
      }
    },
    "The camera did not respond; is it in playback or a menu?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera hat nicht reagiert; ist sie in der Wiedergabe oder in einem Menü?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no ha respondido; ¿está en reproducción o en un menú?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no respondió; ¿está en reproducción o en un menú?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil n’a pas répondu ; est-il en lecture ou dans un menu ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे ने जवाब नहीं दिया; क्या वह प्लेबैक या किसी मेनू में है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak merespons; apakah sedang dalam mode putar ulang atau menu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non ha risposto; è in riproduzione o in un menu?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが応答しませんでした。再生中やメニュー表示中ではありませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 응답하지 않았습니다. 재생 화면이나 메뉴에 있지 않나요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não respondeu; ela está na reprodução ou num menu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机没有响应；它是否处于回放或菜单中？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機沒有回應；它是否處於播放或選單中？"
          }
        }
      }
    },
    "The camera disconnected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera hat die Verbindung getrennt"
          }
        },
        "es": {
