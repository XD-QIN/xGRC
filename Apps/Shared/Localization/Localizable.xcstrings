    "xGRC needs Location. Allow it in Settings › Privacy › Location Services.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC braucht den Standort. Erlaube ihn unter Einstellungen › Datenschutz › Ortungsdienste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC necesita la ubicación. Permítela en Ajustes › Privacidad › Localización."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC necesita la ubicación. Permítela en Configuración › Privacidad › Localización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC a besoin de la localisation. Autorisez-la dans Réglages › Confidentialité › Service de localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC को स्थान की अनुमति चाहिए। सेटिंग्स › गोपनीयता › स्थान सेवाएँ में अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC memerlukan Lokasi. Izinkan di Pengaturan › Privasi › Layanan Lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC ha bisogno della posizione. Consentila in Impostazioni › Privacy › Localizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRCには位置情報が必要です。「設定」›「プライバシーとセキュリティ」›「位置情報サービス」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC에는 위치 접근이 필요합니다. 설정 › 개인정보 보호 및 보안 › 위치 서비스에서 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O xGRC precisa da Localização. Permita em Ajustes › Privacidade › Serviços de Localização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC 需要定位。请在“设置 › 隐私 › 定位服务”中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "xGRC 需要定位。請在「設定 › 隱私權 › 定位服務」中允許。"
          }
        }
