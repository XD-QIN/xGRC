    "Fujifilm cameras end a bulb by themselves at 60 minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujifilm-Kameras beenden eine Bulb-Belichtung nach 60 Minuten von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cámaras Fujifilm terminan un bulb por sí solas a los 60 minutos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cámaras Fujifilm terminan un bulb por sí solas a los 60 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils Fujifilm arrêtent d’eux-mêmes une pose B à 60 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujifilm कैमरे 60 मिनट पर बल्ब को अपने-आप समाप्त कर देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera Fujifilm mengakhiri bulb sendiri pada 60 menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fotocamere Fujifilm chiudono da sole una posa B a 60 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujifilmのカメラは、60分でバルブを自動的に終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujifilm 카메라는 60분이 되면 벌브를 스스로 종료합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As câmeras Fujifilm encerram um bulb sozinhas aos 60 minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujifilm 相机会在 60 分钟时自行结束 B 门。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Fujifilm 相機會在 60 分鐘時自行結束 B 快門。"
          }
        }
      }
    },
