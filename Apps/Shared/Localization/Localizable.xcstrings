            "state": "translated",
            "value": "La cámara se ha desconectado"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se desconectó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil s’est déconnecté"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा डिस्कनेक्ट हो गया"
