    ", or stop location on any other phone or watch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ", oder beende das Senden des Standorts auf jedem anderen Telefon oder jeder anderen Uhr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", o detén la ubicación en cualquier otro móvil o reloj."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": ", o detén la ubicación en cualquier otro celular o reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ", ou arrêtez l’envoi de position sur tout autre téléphone ou montre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ", या किसी दूसरे फ़ोन या वॉच पर स्थान भेजना बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ", atau hentikan lokasi di ponsel atau jam tangan lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ", oppure interrompi l'invio della posizione su ogni altro telefono od orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "。または、ほかのスマートフォンやウォッチで位置情報の送信を停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ". 또는 다른 휴대폰이나 워치에서 위치 전송을 중지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ", ou pare o envio de localização em qualquer outro celular ou relógio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，或在其他手机或手表上停止发送位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，或在其他手機或手錶上停止傳送位置。"
          }
        }
      }
    },
    ", then start again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ", dann starte erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", y vuelve a empezar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": ", y vuelve a empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ", puis relancez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": ", फिर दोबारा शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ", lalu mulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ", poi avvia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "。その後、もう一度開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ". 그런 다음 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ", depois inicie de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，然后重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，然後重新開始。"
          }
        }
      }
    },
