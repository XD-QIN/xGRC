    },
    "Geotagging keeps running with the phone locked. The Live Activity shows it on the Lock Screen and in the Dynamic Island.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geotagging läuft auch bei gesperrtem iPhone weiter. Die Live-Aktivität zeigt es auf dem Sperrbildschirm und in der Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El geoetiquetado sigue funcionando con el móvil bloqueado. La Actividad en directo lo muestra en la pantalla bloqueada y en la Dynamic Island."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El geoetiquetado sigue funcionando con el celular bloqueado. La Actividad en vivo lo muestra en la pantalla bloqueada y en la Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le géomarquage continue avec le téléphone verrouillé. L’activité en direct l’affiche sur l’écran verrouillé et dans la Dynamic Island."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन लॉक होने पर भी जियोटैगिंग चलती रहती है। लाइव ऐक्टिविटी इसे लॉक स्क्रीन पर और Dynamic Island में दिखाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geotagging tetap berjalan saat ponsel terkunci. Aktivitas Langsung menampilkannya di Layar Terkunci dan di Dynamic Island."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il geotagging continua anche con il telefono bloccato. L'Attività in tempo reale lo mostra nella schermata di blocco e nella Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneをロックしてもジオタグ付けは続きます。ライブアクティビティが、ロック画面とDynamic Islandに状況を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 잠가도 지오태깅은 계속됩니다. 실시간 현황이 잠금 화면과 Dynamic Island에 상태를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geomarcação continua com o celular bloqueado. A Atividade ao Vivo a mostra na Tela Bloqueada e na Dynamic Island."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机锁定后地理标记仍会继续。实时活动会在锁定屏幕和灵动岛上显示它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機鎖定後地理標記仍會繼續。即時動態會在鎖定畫面和動態島上顯示它。"
          }
        }
      }
    },
