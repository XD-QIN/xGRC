    "Above 1 s the shutter runs as bulb; set the camera to BULB. Release delay does not apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über 1 s läuft der Verschluss als Bulb; stelle die Kamera auf BULB. Die Auslöseverzögerung gilt dann nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de 1 s el obturador funciona en bulb; pon la cámara en BULB. El retardo de disparo no se aplica."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de 1 s el obturador funciona en bulb; pon la cámara en BULB. El retardo de disparo no se aplica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà de 1 s, l’obturateur passe en pose B ; réglez l’appareil sur BULB. Le délai de déclenchement ne s’applique pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 सेकंड से ज़्यादा होने पर शटर बल्ब की तरह चलता है; कैमरे को BULB पर सेट करें। रिलीज़ डिले लागू नहीं होता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di atas 1 dtk, rana berjalan sebagai bulb; atur kamera ke BULB. Tunda rana tidak berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oltre 1 s l'otturatore lavora in posa B; imposta la fotocamera su BULB. Il ritardo di scatto non si applica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1秒を超えるとバルブで撮影します。カメラをBULBに設定してください。レリーズ遅延は適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1초를 넘으면 벌브로 촬영합니다. 카메라를 BULB로 설정하세요. 릴리즈 지연은 적용되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima de 1 s, o obturador funciona em bulb; ajuste a câmera para BULB. O atraso do disparo não se aplica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 1 秒时快门以 B 门方式运行；请将相机设为 BULB。延迟快门不适用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 1 秒時快門以 B 快門方式運作；請將相機設為 BULB。延遲快門不適用。"
          }
        }
      }
    },
