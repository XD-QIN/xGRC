    "Tap focuses, double tap shoots. A hand Double Tap focuses and shoots.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen fokussiert, zweimal tippen löst aus. Doppeltippen mit der Hand fokussiert und löst aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque enfoca, un doble toque dispara. Un Doble toque con la mano enfoca y dispara."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque enfoca, un doble toque dispara. Un Doble toque con la mano enfoca y dispara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher fait la mise au point, un double toucher déclenche. Le geste Toucher deux fois fait la mise au point et déclenche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैप फ़ोकस करता है, डबल टैप शूट करता है। हाथ से डबल टैप फ़ोकस करके शूट करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk fokus, ketuk dua kali untuk memotret. Ketuk Dua Kali dengan jari memfokus lalu memotret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco mette a fuoco, due tocchi scattano. Il Doppio tocco con la mano mette a fuoco e scatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでフォーカス、ダブルタップで撮影。手のダブルタップでは、フォーカスして撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 초점, 두 번 탭하면 촬영. 이중 탭하면 초점을 맞추고 촬영합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque foca, toque duplo dispara. O Toque Duplo com a mão foca e dispara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点对焦，轻点两下拍摄。“互点两下”手势会对焦并拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點對焦，輕點兩下拍攝。「點兩下」手勢會對焦並拍攝。"
          }
        }
      }
    },
