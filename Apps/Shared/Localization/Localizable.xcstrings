            "value": "Garder l’appareil éveillé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे को जगाए रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga kamera tetap aktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni attiva la fotocamera"
          }
        },
