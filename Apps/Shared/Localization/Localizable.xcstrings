            "value": "La cámara se ha desconectado. Reconexión automática está desactivada en Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se desconectó. Reconexión automática está desactivada en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil s’est déconnecté. La reconnexion auto est désactivée dans Réglages."
          }
