          "stringUnit": {
            "state": "translated",
            "value": "%lld मिनट तक उपयोग न होने के बाद डिस्कनेक्ट किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diputus setelah %lld menit tanpa digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnessa dopo %lld minuti di inattività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分間使用されなかったため、切断しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분 동안 사용하지 않아 연결을 해제했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado após %lld minutos sem uso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟未使用，已断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分鐘未使用，已中斷連線。"
          }
        }
      }
    },
    "Don't force-quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No fuerces el cierre"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No fuerces el cierre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne forcez pas la fermeture"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़बरदस्ती बंद न करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan paksa keluar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiudere l'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強制終了しないでください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 종료하지 마세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não force o encerramento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要强制退出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要強制結束"
          }
        }
      }
    },
    "Don't swipe xGRC away while you shoot. That drops the camera. Use End session instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische xGRC beim Fotografieren nicht weg. Das trennt die Kamera. Nutze stattdessen „Sitzung beenden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cierres xGRC deslizando mientras disparas. Eso desconecta la cámara. Usa Finalizar sesión en su lugar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No cierres xGRC deslizando mientras disparas. Eso desconecta la cámara. Usa Finalizar sesión en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fermez pas xGRC d’un balayage pendant la prise de vue. Cela coupe la liaison avec l’appareil. Utilisez plutôt Terminer la session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शूट करते समय xGRC को स्वाइप करके बंद न करें। इससे कैमरे का कनेक्शन टूट जाता है। इसकी जगह “सेशन समाप्त करें” का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan geser xGRC keluar saat memotret. Itu memutus kamera. Gunakan Akhiri sesi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiudere xGRC con uno swipe mentre scatti. Così la fotocamera si disconnette. Usa invece Termina sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影中はxGRCを上にスワイプして閉じないでください。カメラとの接続が切れます。代わりに「セッションを終了」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 중에는 xGRC를 쓸어 올려 닫지 마세요. 카메라 연결이 끊깁니다. 대신 '세션 종료'를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não feche o xGRC deslizando enquanto fotografa. Isso derruba a conexão com a câmera. Use Encerrar sessão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄时不要把 xGRC 从后台划掉，那样会断开相机。请改用“结束会话”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝時不要把 xGRC 從背景滑掉，那樣會中斷相機連線。請改用「結束工作階段」。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "es": {
          "stringUnit": {
