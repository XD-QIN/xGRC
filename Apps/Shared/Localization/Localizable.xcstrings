          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Double tap or Shoot counts down, then fires. A tap during the countdown cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal tippen oder „Auslösen“ startet den Countdown, dann wird ausgelöst. Tippen während des Countdowns bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doble toque o Disparar inicia la cuenta atrás y luego dispara. Un toque durante la cuenta atrás la cancela."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doble toque o Disparar inicia la cuenta regresiva y luego dispara. Un toque durante la cuenta regresiva la cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un double toucher ou Déclencher lance le compte à rebours, puis déclenche. Un toucher pendant le compte à rebours annule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डबल टैप या शूट से काउंटडाउन चलता है, फिर शटर फ़ायर होता है। काउंटडाउन के दौरान टैप करने से रद्द हो जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali atau Potret menghitung mundur, lalu memicu rana. Ketukan selama hitung mundur membatalkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due tocchi o Scatta avviano il conto alla rovescia, poi scattano. Un tocco durante il conto alla rovescia annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップまたは「撮影」でカウントダウンが始まり、その後シャッターを切ります。カウントダウン中にタップするとキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하거나 '촬영'을 누르면 카운트다운 후 셔터가 작동합니다. 카운트다운 중에 탭하면 취소됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duplo ou Disparar faz a contagem regressiva e depois dispara. Um toque durante a contagem cancela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下或“拍摄”会先倒计时，然后释放快门。倒计时期间轻点即取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點兩下或「拍攝」會先倒數，然後釋放快門。倒數期間輕點即取消。"
          }
        }
      }
    },
    "End session": {
      "localizations": {
        "de": {
          "stringUnit": {
