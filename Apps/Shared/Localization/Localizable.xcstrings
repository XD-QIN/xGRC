    "Pair a wireless remote (ML-L7): Setup menu › Wireless remote (ML-L7) options › Save wireless remote. SnapBridge (smart device) pairing is not supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln als Fernauslöser (ML-L7): Setup menu › Wireless remote (ML-L7) options › Save wireless remote. Koppeln über SnapBridge (Smart-Gerät) wird nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un mando inalámbrico (ML-L7): Setup menu › Wireless remote (ML-L7) options › Save wireless remote. No se admite el emparejamiento con SnapBridge (dispositivo inteligente)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un control remoto inalámbrico (ML-L7): Setup menu › Wireless remote (ML-L7) options › Save wireless remote. No se admite el emparejamiento con SnapBridge (dispositivo inteligente)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelez une télécommande sans fil (ML-L7) : Setup menu › Wireless remote (ML-L7) options › Save wireless remote. Le jumelage SnapBridge (appareil mobile) n’est pas pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वायरलेस रिमोट (ML-L7) पेयर करें: Setup menu › Wireless remote (ML-L7) options › Save wireless remote। SnapBridge (स्मार्ट डिवाइस) पेयरिंग समर्थित नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangkan remote nirkabel (ML-L7): Setup menu › Wireless remote (ML-L7) options › Save wireless remote. Pemasangan SnapBridge (perangkat pintar) tidak didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina come telecomando wireless (ML-L7): Setup menu › Wireless remote (ML-L7) options › Save wireless remote. L'abbinamento SnapBridge (dispositivo smart) non è supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワイヤレスリモコン（ML-L7）としてペアリングします：Setup menu › Wireless remote (ML-L7) options › Save wireless remote。SnapBridge（スマートデバイス）でのペアリングには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무선 리모컨(ML-L7)으로 페어링하세요: Setup menu › Wireless remote (ML-L7) options › Save wireless remote. SnapBridge(스마트 기기) 페어링은 지원하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe um controle remoto sem fio (ML-L7): Setup menu › Wireless remote (ML-L7) options › Save wireless remote. O emparelhamento pelo SnapBridge (dispositivo inteligente) não é suportado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对无线遥控器（ML-L7）：Setup menu › Wireless remote (ML-L7) options › Save wireless remote。不支持 SnapBridge（智能设备）配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對無線遙控器（ML-L7）：Setup menu › Wireless remote (ML-L7) options › Save wireless remote。不支援 SnapBridge（智慧型裝置）配對。"
          }
        }
      }
    },
