          "stringUnit": {
            "state": "translated",
            "value": "Kamera getrennt. Der Standort wird wieder gesendet, sobald sie zurück ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara desconectada. La ubicación se reanuda cuando vuelva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara desconectada. La ubicación se reanuda cuando vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareil déconnecté. L’envoi de position reprend à son retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा डिस्कनेक्ट हो गया। उसके लौटने पर स्थान भेजना फिर शुरू होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera terputus. Lokasi dilanjutkan saat kamera kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera disconnessa. La posizione riprende quando torna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラとの接続が切れました。再接続すると位置情報の送信を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 연결이 끊겼습니다. 다시 연결되면 위치 전송을 재개합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera desconectada. O envio de localização volta quando ela voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机已断开。相机恢复连接后会继续发送位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機已中斷連線。相機恢復連線後會繼續傳送位置。"
          }
        }
      }
    },
