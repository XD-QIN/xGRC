    "Disconnected after %lld minutes without reaching the camera.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %lld Minuten ohne Kontakt zur Kamera getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado tras %lld minutos sin conectar con la cámara."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado después de %lld minutos sin conectar con la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté après %lld minutes sans pouvoir joindre l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld मिनट तक कैमरे तक न पहुँच पाने के बाद डिस्कनेक्ट किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diputus setelah %lld menit tanpa bisa menjangkau kamera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnessa dopo %lld minuti senza raggiungere la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラに接続できないまま%lld分経過したため、切断しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분 동안 카메라에 연결되지 않아 연결을 해제했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado após %lld minutos sem alcançar a câmera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟内一直联系不上相机，已断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分鐘內一直連不上相機，已中斷連線。"
          }
        }
      }
    },
    "Disconnected after %lld minutes without use.": {
