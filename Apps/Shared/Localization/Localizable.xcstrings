          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera reagisce solo nella modalità di scatto Self-timer: 10 s/remote o 2 s/remote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラは、ドライブモードが「Self-timer: 10 s/remote」または「2 s/remote」のときだけ反応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라는 드라이브 모드가 Self-timer: 10 s/remote 또는 2 s/remote일 때만 반응합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
