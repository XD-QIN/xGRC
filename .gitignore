# Private, per-developer signing values (team ID, bundle-ID prefix).
# Format in Config/Signing.xcconfig, which holds placeholders only.
Config/Local.xcconfig
*.local.xcconfig

# Generated by XcodeGen from project.yml
*.xcodeproj/
*.xcworkspace/
Apps/*/Info.plist
Apps/*/*.entitlements

# Xcode per-user state and build output
xcuserdata/
*.xcuserstate
*.xcbkptlist
DerivedData/
build/
.build/
.swiftpm/
*.xcarchive
*.ipa
*.dSYM/
*.dSYM.zip
*.xcresult/

# Certificates, provisioning profiles and keys
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
AuthKey_*.p8
ExportOptions.plist

# Secrets and local environment files
.env
.env.*
*.pem
*.key

# Videos and large recordings (App Preview video stays out of git)
*.mov
*.mp4
*.m4v

# macOS and editor clutter
.DS_Store
._*
__MACOSX/
.AppleDouble
.Spotlight-V100
.Trashes
*.swp
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json
